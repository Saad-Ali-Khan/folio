{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ocr:prepare": "tsx scripts/ocr/benchmark.ts prepare",
    "ocr:report": "tsx scripts/ocr/benchmark.ts report",
    "ocr:replay": "tsx scripts/ocr/replay-catalog.ts",
    "ocr:trial": "powershell.exe -NoProfile -File scripts/ocr/run-trial.ps1",
    "ocr:stronger": "powershell.exe -NoProfile -File scripts/ocr/run-trial.ps1 -Stronger",
    "ocr:geometry": "powershell.exe -NoProfile -File scripts/ocr/run-trial.ps1 -Geometry",
    "ocr:enable": "tsx scripts/ocr/activate.ts",
    "ocr:check": "tsx scripts/ocr/activate.ts --check",
    "ocr:disable": "tsx scripts/ocr/activate.ts --disable",
    "ocr:expand": "powershell.exe -NoProfile -File scripts/ocr/run-trial.ps1 -Corpus existing -DownloadWebAfter",
    "monitor:production": "node scripts/monitor-production.mjs",
    "photos:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate-photos.ts",
    "db:generate": "drizzle-kit generate",
    "db:setup": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-db.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "backup:create": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backup.ts create",
    "backup:verify": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backup.ts verify",
    "backup:recover-sql": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/backup.ts recover-sql",
    "books": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/books.ts",
    "bot:discord": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/discord-bot.ts",
    "local:start": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/local-services.ts start",
    "local:up": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/local-services.ts up",
    "local:status": "tsx scripts/local-services.ts status",
    "local:stop": "tsx scripts/local-services.ts stop",
    "local:restart": "npm run local:stop && npm run local:up",
    "local:install-startup": "powershell.exe -NoProfile -File scripts/install-local-startup.ps1",
    "orders": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/orders.ts",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "deploy:cloudflare": "node scripts/build-cloudflare.mjs --deploy"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@neondatabase/serverless": "1.2.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/library": "^0.23.0",
    "aws4fetch": "1.0.20",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.5",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "tesseract.js": "^7.0.0",
    "twilio": "^6.2.0",
    "undici": "6.29.1",
    "ws": "8.22.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "bwip-js": "^4.11.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.162.0"
  }
}
