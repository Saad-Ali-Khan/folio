# Production Postgres connection string (Neon, Supabase, RDS, ...).
# Leave empty to use the embedded PGlite database at ./.pglite — zero setup.
DATABASE_URL=

# Stripe test keys: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=

# SMS inventory updates (Twilio inbound webhook).
# Auth token from https://console.twilio.com — used to verify request signatures.
TWILIO_AUTH_TOKEN=
# The only phone number allowed to text inventory commands, in E.164 format.
INVENTORY_SMS_FROM=+15550001111
# Shared secret every SMS must start with, e.g. "4821 SET dune 20".
INVENTORY_SMS_PIN=

# Telegram inventory updates (free alternative to SMS).
# BotFather token, e.g. 123456789:AA...
TELEGRAM_BOT_TOKEN=
# Random string; must match the secret_token used when registering the webhook.
TELEGRAM_WEBHOOK_SECRET=
# The only chat allowed to send commands. Numeric ID, may be negative for groups.
INVENTORY_TELEGRAM_CHAT_ID=
# Shared secret every Telegram command must start with.
INVENTORY_TELEGRAM_PIN=

# Discord inventory updates (free, and works where the Telegram API is blocked).
# Bot token from https://discord.com/developers/applications — enable the
# "Message Content" intent under Bot settings or commands arrive empty.
DISCORD_BOT_TOKEN=
# The only channel allowed to send commands (right-click channel → Copy Channel ID).
DISCORD_CHANNEL_ID=
# Shared secret every Discord command must start with.
INVENTORY_DISCORD_PIN=
# Shared secret between the bot process and the local inventory route.
INVENTORY_DISCORD_SECRET=
# Where `npm run bot:discord` reaches the running app.
INVENTORY_API_URL=http://localhost:3000

# Optional. Used to build Stripe success/cancel URLs and the Twilio signature URL.
# When testing inbound SMS through a tunnel, set this to the tunnel's https URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
